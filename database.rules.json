{
  "rules": {
    ".read": false,
    ".write": false,

    "mm": {
      "$game": {
        "queue": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
          ".indexOn": ["at"],
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (auth.uid === $uid || (data.exists() && !data.child('room').exists() && !data.child('busy').exists() && newData.child('by').val() === auth.uid && newData.child('room').isString() && newData.child('name').val() === data.child('name').val() && newData.child('at').val() === data.child('at').val() && newData.child('v').val() === data.child('v').val()))",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('v').isString() && newData.child('v').val().length <= 32)",
            "name": { ".validate": "newData.isString()" },
            "at": { ".validate": "newData.isNumber() && (newData.val() === data.val() || newData.val() <= now)" },
            "v": { ".validate": "newData.isString()" },
            "busy": { ".validate": "newData.isBoolean()" },
            "room": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "by": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },
        "codes": {
          "$code": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $code.matches(/^[A-Z2-9]{4}$/) && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid && !newData.exists()) || (data.exists() && !data.child('guest').exists() && data.child('host').val() !== auth.uid && newData.child('guest').val() === auth.uid && newData.child('host').val() === data.child('host').val() && newData.child('name').val() === data.child('name').val() && newData.child('v').val() === data.child('v').val() && newData.child('room').isString()))",
            "host": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "at": { ".validate": "newData.isNumber()" },
            "v": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "guest": { ".validate": "newData.isString()" },
            "gname": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "room": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "social": {
      "profiles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider != 'anonymous'",
          ".validate": "newData.hasChildren(['name', 'code', 'at'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
          "code": { ".validate": "newData.isString() && newData.parent().parent().parent().child('codes').child(newData.val()).val() === $uid" },
          "avatar": {
            ".validate": "newData.hasChildren(['game', 'id'])",
            "game": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)" },
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,24}$/)" },
            "$other": { ".validate": false }
          },
          "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      },
      "codes": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "$code.matches(/^[A-Z2-9]{6}$/) && newData.isString()"
        }
      },
      "requests": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          "$from": {
            ".read": "auth != null && auth.uid === $from",
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((auth.uid === $from && $from !== $to && !data.exists() && newData.exists() && !root.child('social/friends/' + $to + '/' + $from).exists() && root.child('social/profiles/' + $to).exists()) || (!newData.exists() && (auth.uid === $to || auth.uid === $from)))",
            ".validate": "newData.hasChildren(['name', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      },
      "friends": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$friend": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $uid !== $friend && ((newData.val() === true && ((auth.uid === $uid && (root.child('social/requests/' + $uid + '/' + $friend).exists() || root.child('social/friends/' + $friend + '/' + $uid).exists())) || (auth.uid === $friend && root.child('social/requests/' + $friend + '/' + $uid).exists()))) || (!newData.exists() && (auth.uid === $uid || auth.uid === $friend)))",
            ".validate": "newData.val() === true"
          }
        }
      },
      "presence": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('social/friends/' + $uid + '/' + auth.uid).exists())",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider != 'anonymous'",
          ".validate": "newData.hasChildren(['state', 'game', 'gameName', 'at'])",
          "state": { ".validate": "newData.val() === 'online' || newData.val() === 'offline'" },
          "game": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)" },
          "gameName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "status": { ".validate": "newData.val() === 'menu' || newData.val() === 'playing'" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      },
      "invites": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          "$id": {
            ".write": "auth != null && ((!data.exists() && auth.token.firebase.sign_in_provider != 'anonymous' && newData.child('from').val() === auth.uid && root.child('social/friends/' + $to + '/' + auth.uid).exists()) || (data.exists() && !newData.exists() && (auth.uid === $to || data.child('from').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['from', 'name', 'game', 'gameName', 'url', 'at'])",
            "from": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "game": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)" },
            "gameName": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "url": { ".validate": "newData.isString() && newData.val().length <= 300 && (newData.val().matches(/^https:\\/\\/(linetower\\.vercel\\.app|androgame\\.vercel\\.app|assassins\\.kump\\.fr|dtrack\\.kump\\.fr|www\\.kump\\.fr)(\\/.*)?$/) || newData.val().matches(/^http:\\/\\/(localhost|127\\.0\\.0\\.1)(:[0-9]+)?(\\/.*)?$/))" },
            "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{4}$/)" },
            "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      },
      "replies": {
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          "$id": {
            ".write": "auth != null && ((newData.exists() && newData.child('by').val() === auth.uid && root.child('social/friends/' + $from + '/' + auth.uid).exists()) || (!newData.exists() && auth.uid === $from))",
            ".validate": "newData.hasChildren(['answer', 'by', 'at'])",
            "answer": { ".validate": "newData.val() === 'accepted' || newData.val() === 'declined'" },
            "by": { ".validate": "newData.isString()" },
            "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      },
      "chats": {
        "$pair": {
          ".read": "auth != null && ($pair.beginsWith(auth.uid + '_') || $pair.endsWith('_' + auth.uid))",
          "$msg": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && !data.exists() && newData.exists() && ($pair.beginsWith(auth.uid + '_') || $pair.endsWith('_' + auth.uid)) && $pair.replace(auth.uid + '_', '').replace('_' + auth.uid, '').length > 0 && $pair.replace(auth.uid + '_', '').replace('_' + auth.uid, '') !== auth.uid && root.child('social/friends/' + auth.uid + '/' + $pair.replace(auth.uid + '_', '').replace('_' + auth.uid, '')).exists()",
            ".validate": "newData.hasChildren(['from', 'text', 'at'])",
            "from": { ".validate": "newData.val() === auth.uid" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
            "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      },
      "unread": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$friend": {
            ".read": "auth != null && auth.uid === $friend",
            ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (auth.uid === $friend && root.child('social/friends/' + $uid + '/' + $friend).exists() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))))",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          }
        }
      }
    },

    "rooms": {
      "$game": {
        "$room": {
          ".read": "auth != null && (data.child('meta/p0').val() === auth.uid || data.child('meta/p1').val() === auth.uid)",
          ".write": "auth != null && !newData.exists() && (data.child('meta/p0').val() === auth.uid || data.child('meta/p1').val() === auth.uid)",

          "meta": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && !data.exists() && newData.child('p1').val() === auth.uid && newData.child('p0').val() !== auth.uid && ((root.child('mm/' + $game + '/queue/' + newData.child('p0').val() + '/room').val() === $room && root.child('mm/' + $game + '/queue/' + newData.child('p0').val() + '/by').val() === auth.uid) || (newData.child('code').isString() && root.child('mm/' + $game + '/codes/' + newData.child('code').val() + '/room').val() === $room && root.child('mm/' + $game + '/codes/' + newData.child('code').val() + '/guest').val() === auth.uid && root.child('mm/' + $game + '/codes/' + newData.child('code').val() + '/host').val() === newData.child('p0').val()))",
            ".validate": "newData.hasChildren(['p0', 'p1', 'n0', 'n1', 'seed', 'v', 'at'])",
            "p0": { ".validate": "newData.isString()" },
            "p1": { ".validate": "newData.isString()" },
            "n0": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "n1": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "seed": { ".validate": "newData.isNumber()" },
            "v": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "at": { ".validate": "newData.isNumber()" },
            "code": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          },

          "t": {
            "$seat": {
              "$i": {
                ".write": "auth != null && !data.exists() && root.child('rooms/' + $game + '/' + $room + '/meta/p' + $seat).val() === auth.uid",
                ".validate": "newData.isString() && newData.val().length <= 4000 && $i.matches(/^[0-9]{1,6}$/)"
              }
            }
          },
          "hash": {
            "$seat": {
              "$i": {
                ".write": "auth != null && root.child('rooms/' + $game + '/' + $room + '/meta/p' + $seat).val() === auth.uid",
                ".validate": "newData.isString() && newData.val().length <= 64 && $i.matches(/^[0-9]{1,6}$/)"
              }
            }
          },
          "ready": {
            "$seat": {
              ".write": "auth != null && root.child('rooms/' + $game + '/' + $room + '/meta/p' + $seat).val() === auth.uid",
              ".validate": "newData.isBoolean()"
            }
          },
          "presence": {
            "$seat": {
              ".write": "auth != null && root.child('rooms/' + $game + '/' + $room + '/meta/p' + $seat).val() === auth.uid",
              ".validate": "newData.isBoolean()"
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
