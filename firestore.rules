rules_version = '2';

// Règles du projet Firebase KUMP — compte joueur partagé entre tous les jeux.
//
// Différence FONDAMENTALE avec les règles précédentes d'Androgame : le jeu
// utilise désormais Firebase Auth, donc `request.auth.uid` existe et chaque
// document peut être rattaché à son propriétaire. Un joueur ne peut plus
// écrire que chez LUI — ce que les anciennes règles ne pouvaient pas garantir
// (voir Androgame > AUDIT.md, SEC-01/SEC-02).
//
// Ce que ces règles garantissent :
//   - personne ne peut lire ni écrire le profil d'un autre joueur ;
//   - personne ne peut publier un score sous l'identité d'un autre ;
//   - un compte anonyme ne peut pas apparaître au classement.
//
// Depuis la PHASE 3 (voir Androgame > AUDIT.md §3), elles garantissent AUSSI
// la valeur de ce qu'un joueur possède : pièces, progression, diamants,
// trophées, temps de jeu et classement ne sont plus écrits que par le serveur
// de validation (routes /api/game/* de kump.fr, via le SDK admin qui contourne
// ces règles). Un client ne peut plus modifier que ses préférences
// d'apparence, qui n'ont aucune valeur de jeu.
//
// Ce qui reste hors de portée de ces règles : un joueur peut toujours modifier
// le moteur du jeu dans son navigateur pour se rendre invincible et finir un
// niveau qu'il n'aurait pas réussi. Le serveur ne peut pas rejouer la partie ;
// il vérifie la plausibilité (pièces existantes, durée cohérente), pas le
// talent. C'est la limite assumée d'un anti-triche sans anti-cheat natif.
//
// Déploiement : firebase deploy --only firestore:rules --project <projet-kump>

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Préférences d'apparence d'un jeu : les deux seuls champs qu'un client a
    // encore le droit d'écrire depuis la phase 3 (voir `games/{gameId}`).
    // Chaque champ est vérifié S'IL EST PRÉSENT, jamais exigé — voir le
    // commentaire de `allow create` plus bas pour le cas réel que l'exiger
    // refusait. Un identifiant de skin de plus de 64 caractères n'existe dans
    // aucun catalogue : la borne empêche de semer un document énorme.
    function hasBoundedAppearance(data) {
      return (!('equippedSkin' in data) || (data.equippedSkin is string && data.equippedSkin.size() <= 64))
        && (!('equippedTrail' in data) || (data.equippedTrail is string && data.equippedTrail.size() <= 64));
    }

    // --- Profil global du joueur -------------------------------------------
    // Lisible par son seul propriétaire. Le pseudo affiché publiquement est
    // recopié dans l'entrée de classement (voir plus bas), ce qui évite
    // d'ouvrir la lecture de tout le profil à tout le monde.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'lastSeenAt', 'totalPlaytimeMs'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 16
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.totalPlaytimeMs == 0;
      // VERROUILLÉ (phase 3) : le client ne peut plus toucher qu'à son pseudo
      // et à sa date de dernière visite. `totalPlaytimeMs` est désormais écrit
      // UNIQUEMENT par le serveur de validation, à partir de la durée réelle
      // d'une partie qu'il a lui-même jugée plausible — un client ne peut donc
      // plus s'inventer des heures de jeu.
      //
      // Le SDK admin (serveur) contourne ces règles par construction : elles
      // ne s'appliquent qu'aux clients.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'lastSeenAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 16;
      allow delete: if false;

      // --- Données d'un jeu, pour ce joueur -------------------------------
      // Forme LIBRE : chaque jeu range ce qu'il veut (voir gameData.js).
      // Ajouter un jeu ne doit jamais demander de toucher à ces règles — d'où
      // l'absence de `hasOnly()` ici, contrairement au profil global.
      // Bornes de bon sens uniquement, pour éviter qu'un client fabrique un
      // document énorme et fasse exploser la facture Firestore.
      // VERROUILLÉ (phase 3) — LE changement qui rend l'anti-triche réel.
      //
      // Avant : le client écrivait librement ses pièces, sa progression et ses
      // diamants ; les valider côté serveur n'aurait servi à rien, puisque
      // l'ancienne porte restait ouverte à côté.
      //
      // Maintenant : il ne peut plus modifier QUE ses préférences d'apparence
      // (skin et traînée équipés — aucune valeur, aucun enjeu de triche). Tout
      // le reste — `coins`, `levelProgress`, `collectedDiamonds`, `ownedSkins`,
      // `ownedTrails`, `playtimeMs`, `runCount` — n'est écrit que par le
      // serveur de validation, via le SDK admin qui contourne ces règles.
      //
      // ⚠️ Un jeu qui tenterait encore d'écrire ces champs directement recevra
      // un `permission-denied`. C'est voulu : la seule voie légitime est
      // `submitRun()` (voir kump-account > runs.js).
      match /games/{gameId} {
        allow read: if isOwner(uid);
        // Création du document au tout premier lancement : seules les
        // préférences d'apparence, rien de gagnable. `keys()` et non `diff()`
        // — sur une création il n'y a pas de document précédent à comparer.
        //
        // Chaque champ est vérifié S'IL EST PRÉSENT, jamais exigé. Les exiger
        // tous les deux (ce que faisaient ces règles) refusait un cas réel :
        // le document peut avoir été créé par le SERVEUR au premier run validé
        // — il n'y met alors que ce qu'il accorde, donc pas de skin équipé — et
        // le joueur qui équipait ensuite une traînée se voyait refuser
        // l'écriture, parce que `equippedSkin` manquait au document résultant.
        //
        // La borne de taille, elle, s'applique aussi à la création : sans
        // elle, un client pouvait semer un document d'un mégaoctet.
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['equippedSkin', 'equippedTrail'])
          && hasBoundedAppearance(request.resource.data);
        // ⚠️ Jamais de `keys().hasOnly()` ici, contrairement à la création :
        // `request.resource.data` est le document RÉSULTANT, qui contient les
        // pièces, la progression et les diamants écrits par le serveur. Le
        // périmètre de l'écriture se contrôle par `diff().affectedKeys()`,
        // qui ne regarde QUE ce qui change.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['equippedSkin', 'equippedTrail'])
          && hasBoundedAppearance(request.resource.data);
        allow delete: if false;

        // --- Trophées --------------------------------------------------
        // Normalisés (kump.fr les affiche pour tous les jeux de la même
        // façon) : un document par trophée, une seule date, jamais modifiable
        // après coup — un trophée obtenu le reste, avec sa date d'origine.
        // VERROUILLÉ (phase 3) : les trophées sont attribués par le serveur,
        // qui recalcule les conditions à partir de la progression qu'il
        // détient. Un client ne peut plus s'en octroyer.
        match /trophies/{trophyId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    // --- Classements, un par jeu -------------------------------------------
    // Lecture publique (c'est un classement), écriture réservée au
    // propriétaire de l'entrée : `entries/{uid}` avec `uid == request.auth.uid`
    // rend structurellement impossible d'écrire un score sous le nom d'un
    // autre joueur — la faille SEC-01 des anciennes règles d'Androgame.
    // VERROUILLÉ (phase 3) : le classement est publié par le SERVEUR, qui
    // recalcule progression et diamants à partir des données qu'il détient.
    // C'est la fermeture de la faille SEC-04 — un joueur pouvait se déclarer à
    // 100 % partout en trafiquant son stockage local.
    //
    // Lecture publique (c'est un classement), écriture par personne : ni un
    // joueur, ni même un administrateur depuis son navigateur. La modération
    // passe par les routes serveur du panel admin.
    match /leaderboards/{gameId}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // --- Catalogue public des jeux -----------------------------------------
    // Nom, icône, liste des trophées et leurs libellés : lu par kump.fr pour
    // afficher "3 trophées sur 12" sans que le site connaisse chaque jeu.
    // Écriture réservée à la console Firebase (aucun client n'y touche).
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Tout le reste est fermé par défaut : une collection oubliée n'est jamais
    // ouverte par accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
